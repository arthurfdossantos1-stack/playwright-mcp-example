# Copie para .env (no mesmo diretorio) e preencha.
#
# O .env nao entra em commit. Com ele no lugar, "npm start" funciona direto:
# nao precisa exportar nada toda vez que abrir o Termux.

# O site publicado.
APP_URL=https://SEU-SITE.netlify.app

# A MESMA coisa que WHATSAPP_WORKER_SECRET na Netlify.
CHAVE=

# Aparece na tela "Disparo automatico" do app, no cartao Servidor.
USUARIO_ID=

# Daqui pra baixo e tudo opcional.
# DADOS_DIR=./dados
# TETO_INICIAL=20
# TETO_MAXIMO=60
# ESPERA_OCIOSO=8
# TOLERANCIA_QUEDA=180
