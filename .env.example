# ---------------------------------------------------------------------------
# RastroLead - variaveis de ambiente
# Copie para .env.local e preencha. Nenhuma delas envolve cobranca/planos.
# ---------------------------------------------------------------------------

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Usada apenas no servidor (worker de follow-up). NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Google Places API (New) - habilite "Places API (New)" no Google Cloud
GOOGLE_PLACES_API_KEY=sua-chave-do-google-places

# Gemini API (tier gratuito) - gera o prompt de previa de site em texto.
# Crie em https://aistudio.google.com/apikey (nunca exponha no frontend).
GEMINI_API_KEY=sua-chave-do-gemini
GEMINI_MODEL=gemini-flash-latest

# Cota diaria do gerador de previa de site (limite TECNICO, nao e plano).
PREVIAS_LIMITE_DIARIO=5

# URL publica do site (usada em OAuth redirect, sitemap e metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do endpoint de cron (/api/cron/follow-ups)
CRON_SECRET=troque-por-um-segredo-longo

# Rate limit tecnico (protege a cota do Google, NAO e um plano)
# Requisicoes de busca permitidas por janela, por usuario/IP.
RATE_LIMIT_BUSCAS_POR_MINUTO=10
RATE_LIMIT_JANELA_SEGUNDOS=60

# CAPTCHA do cadastro (opcional, gratuito).
# 1. Crie um site em https://dash.cloudflare.com/?to=/:account/turnstile
# 2. Cole a chave PUBLICA aqui e a SECRETA no painel do Supabase em
#    Authentication > Attack Protection > Enable CAPTCHA protection.
# Sem essa variavel o cadastro funciona normalmente, so sem o CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Busca no Instagram (opcional) - Apify.
# 1. Crie conta gratuita em https://console.apify.com
# 2. Settings > API & Integrations > copie o Personal API token
# O plano gratuito da US$ 5 de credito/mes (~1.900 perfis). Os dois tetos
# abaixo existem pra voce NAO passar disso sem querer: o app checa a cota
# antes de cada varredura e recusa quando estoura.
# Sem APIFY_TOKEN a fonte "Instagram" fica indisponivel e o Google segue igual.
APIFY_TOKEN=
# Ator da Apify Store que faz a busca. So mexa se o padrao parar de
# funcionar: copie o id da URL da Store (dono/nome) e cole aqui.
APIFY_ATOR_BUSCA=apify/instagram-search-scraper
APIFY_MAX_POR_BUSCA=40
APIFY_LIMITE_MENSAL=1500

# Disparo automatico de WhatsApp (opcional).
# Exige um servidor ligado 24h - a Netlify NAO serve. O codigo esta em
# servidor-whatsapp/, com as instrucoes de deploy no README de la.
# O mesmo valor de WHATSAPP_WORKER_SECRET vai na variavel CHAVE do servidor.
# Sem essas duas, a tela de disparo explica o que falta e nada quebra.
WHATSAPP_WORKER_URL=
WHATSAPP_WORKER_SECRET=
