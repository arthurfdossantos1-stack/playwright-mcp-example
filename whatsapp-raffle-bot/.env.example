# Numeros que, alem de voce mesmo, podem registrar vendas mandando mensagem
# direto para o numero do bot (conversa com voce mesmo sempre funciona, sem
# precisar estar aqui).
# Formato: DDI+DDD+numero, so digitos, separados por virgula.
# Exemplo: 5511999999999,5511988888888
AUTHORIZED_NUMBERS=

# Opcional: se preenchido, o bot pede direto um CODIGO DE PAREAMENTO para
# esse numero ao iniciar (em vez de perguntar no terminal), sem precisar
# escanear QR. Formato: DDI+DDD+numero, so digitos. Deixe vazio para
# escolher na hora (o bot pergunta no terminal, com o QR como alternativa).
PAIRING_NUMBER=

# Opcional: um nome/apelido para o bot. Mandar so esse nome (com ou sem
# acento, maiusculo ou minusculo) funciona como um "oi, ta ai?" - o bot
# responde confirmando que esta online. O bot so responde comandos e a esse
# nome; qualquer outra mensagem (tipo "oi", papo comum) fica sem resposta.
# Exemplo: BOT_NAME=Pierre
BOT_NAME=

# Dados que o comando "pix" devolve pra quem perguntar como pagar.
# So PIX_KEY e obrigatorio pra o comando funcionar; PIX_NAME e PIX_BANK sao
# so pra deixar a mensagem mais completa.
PIX_KEY=
PIX_NAME=
PIX_BANK=

# Opcional: se preenchido, o comando "pix" manda esse texto do jeito que
# estiver aqui, ignorando PIX_KEY/PIX_NAME/PIX_BANK. Use \n para quebrar
# linha. Exemplo: PIX_MESSAGE=Chave: 11999999999 (celular)\nNome: Arthur
PIX_MESSAGE=
