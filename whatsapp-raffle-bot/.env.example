# Numeros que, alem de voce mesmo, podem registrar vendas mandando mensagem
# direto para o numero do bot (conversa com voce mesmo sempre funciona, sem
# precisar estar aqui).
# Formato: DDI+DDD+numero, so digitos, separados por virgula.
# Exemplo: 5511999999999,5511988888888
AUTHORIZED_NUMBERS=

# Opcional: se preenchido, o bot pede direto um CODIGO DE PAREAMENTO para
# esse numero ao iniciar (em vez de perguntar no terminal), sem precisar
# escanear QR. Formato: DDI+DDD+numero, so digitos. Deixe vazio para
# escolher na hora (o bot pergunta no terminal, com o QR como alternativa).
PAIRING_NUMBER=
